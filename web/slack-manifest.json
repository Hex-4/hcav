{
	"display_information": {
		"name": "The Organization",
		"description": "HCAV team HQ setup and channel membership.",
		"background_color": "#c73525"
	},
	"features": {
		"bot_user": {
			"display_name": "The Organization",
			"always_online": false
		},
		"slash_commands": [
			{
				"command": "/hcav",
				"url": "https://hcav.hackclub.com/slack/command",
				"description": "Set this channel as your team's HQ",
				"usage_hint": "hq",
				"should_escape": false
			}
		]
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"commands",
				"chat:write",
				"channels:read",
				"groups:read",
				"channels:write.invites",
				"groups:write.invites"
			]
		}
	},
	"settings": {
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
